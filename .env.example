# =====================================================
# TEMPLATE ENVIRONMENT VARIABLES
# Salin file ini menjadi .env.local lalu isi nilainya
# =====================================================

# ID Google Spreadsheet (ambil dari URL spreadsheet)
NEXT_PUBLIC_SHEET_ID=your_google_sheet_id_here

# Tanggal pengumuman dibuka (format: YYYY-MM-DDTHH:MM:SS+07:00)
NEXT_PUBLIC_ANNOUNCEMENT_DATE=2026-09-11T12:00:00+07:00

# Session secret — buat string random panjang di sini
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=isi-dengan-string-random-minimal-32-karakter
